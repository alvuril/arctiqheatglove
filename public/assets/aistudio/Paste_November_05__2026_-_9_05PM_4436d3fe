    <!-- JAVASCRIPT CONTROLLERS -->
    <script>
        // Heat Mode Simulator Logic
        let activeMode = 'off';
        const filaments = document.getElementById('heat-filaments');
        const statusLed = document.getElementById('status-led');
        const hudStatus = document.getElementById('hud-status');
        const hudTemp = document.getElementById('hud-temp');
        const hudRuntime = document.getElementById('hud-runtime');

        function setHeatMode(mode) {
            activeMode = mode;

            // Reset buttons style
            document.querySelectorAll('.mode-btn').forEach(btn => {
                btn.classList.remove('border-brand-ember', 'border-brand-amber', 'border-brand-ice', 'border-white/40', 'bg-white/15');
                btn.classList.add('border-white/10', 'bg-brand-card');
            });

            // Target Active Button
            const targetBtn = document.getElementById(`btn-${mode}`);
            targetBtn.classList.remove('bg-brand-card');
            targetBtn.classList.add('bg-white/15');

            filaments.classList.remove('heat-active');

            if(mode === 'off') {
                targetBtn.classList.add('border-white/40');
                filaments.setAttribute('stroke', '#384152');
                statusLed.setAttribute('fill', '#384152');
                hudStatus.textContent = 'Standby (Passive)';
                hudTemp.textContent = 'OFF';
                hudTemp.className = 'font-bold text-gray-500 font-display text-sm';
                hudRuntime.textContent = 'Standby';
            } 
            else if(mode === 'eco') {
                targetBtn.classList.add('border-brand-ice');
                filaments.setAttribute('stroke', '#38bdf8');
                statusLed.setAttribute('fill', '#38bdf8');
                hudStatus.textContent = 'Alpine Eco Active';
                hudTemp.textContent = '35°C / 95°F';
                hudTemp.className = 'font-bold text-brand-ice font-display text-sm';
                hudRuntime.textContent = '~ 10.5 Hours';
                filaments.classList.add('heat-active');
            } 
            else if(mode === 'active') {
                targetBtn.classList.add('border-brand-amber');
                filaments.setAttribute('stroke', '#ff9900');
                statusLed.setAttribute('fill', '#ff9900');
                hudStatus.textContent = 'Storm Mode Active';
                hudTemp.textContent = '45°C / 113°F';
                hudTemp.className = 'font-bold text-brand-amber font-display text-sm';
                hudRuntime.textContent = '~ 6.5 Hours';
                filaments.classList.add('heat-active');
            } 
            else if(mode === 'peak') {
                targetBtn.classList.add('border-brand-ember');
                filaments.setAttribute('stroke', '#ff3300');
                statusLed.setAttribute('fill', '#ff3300');
                hudStatus.textContent = 'Arctic Void Max Output';
                hudTemp.textContent = '55°C / 131°F';
                hudTemp.className = 'font-bold text-brand-ember font-display text-sm';
                hudRuntime.textContent = '~ 3.5 Hours';
                filaments.classList.add('heat-active');
            }
        }

        // Size Selector
        let selectedSize = 'M';
        function selectSize(size) {
            selectedSize = size;
            document.querySelectorAll('.size-btn').forEach(btn => {
                btn.classList.remove('border-white/40', 'bg-white/20', 'text-white');
                btn.classList.add('border-white/10', 'bg-white/5');
            });
            event.target.classList.add('border-white/40', 'bg-white/20', 'text-white');
        }

        // Cart State & Drawer Logic
        let cart = [];
        const cartDrawer = document.getElementById('cart-drawer');
        const cartPanel = document.getElementById('cart-panel');
        const cartCounter = document.getElementById('cart-counter');
        const cartItems = document.getElementById('cart-items');
        const cartTotal = document.getElementById('cart-total');

        function toggleCart() {
            const isOpen = !cartDrawer.classList.contains('pointer-events-none');
            if (isOpen) {
                cartDrawer.classList.add('pointer-events-none', 'opacity-0');
                cartPanel.classList.add('translate-x-full');
            } else {
                cartDrawer.classList.remove('pointer-events-none', 'opacity-0');
                cartPanel.classList.remove('translate-x-full');
            }
        }

        function addToCart() {
            cart.push({
                name: 'ARCTIQ HeatGlove™',
                size: selectedSize,
                price: 289.00
            });
            renderCart();
            toggleCart();
        }

        function renderCart() {
            cartCounter.textContent = cart.length;
            if(cart.length === 0) {
                cartItems.innerHTML = '<p class="text-gray-500 text-sm text-center py-10">Your pack is currently empty.</p>';
                cartTotal.textContent = '$0.00';
                return;
            }

            let total = 0;
            cartItems.innerHTML = '';
            cart.forEach((item, index) => {
                total += item.price;
                const div = document.createElement('div');
                div.className = 'flex justify-between items-center bg-black/30 p-3 rounded-lg border border-white/5';
                div.innerHTML = `
                    <div>
                        <p class="font-bold text-sm text-white">${item.name}</p>
                        <p class="text-xs text-gray-400">Size: ${item.size} &bull; Obsidian Black</p>
                    </div>
                    <div class="text-right">
                        <span class="text-sm font-bold text-white">$${item.price}</span>
                        <button onclick="removeFromCart(${index})" class="block text-[10px] text-brand-ember hover:underline">Remove</button>
                    </div>
                `;
                cartItems.appendChild(div);
            });
            cartTotal.textContent = `$${total.toFixed(2)}`;
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            renderCart();
        }
    </script>
